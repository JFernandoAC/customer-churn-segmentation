table customer_scores
	lineageTag: 9d3ed107-73e1-416a-9704-79334a169fdf

	measure 'Customers scored' = COUNTROWS(customer_scores)
		formatString: #,0
		lineageTag: ce77edfa-9295-47b6-89b4-b4d76da73026

	measure 'High risk customers' = CALCULATE([Customers scored], customer_scores[risk_level] = "High")
		formatString: #,0
		lineageTag: d8d5cd05-c2b2-4fc7-8ddf-63a111b8b128

	measure '% high risk' = DIVIDE([High risk customers], [Customers scored])
		formatString: 0.0%
		lineageTag: bc6765cc-c4c6-48a1-84c9-16a49d7ae06b

	measure 'Revenue at risk' = CALCULATE(SUM(customer_scores[monetary]), customer_scores[risk_level] = "High")
		formatString: "£"#,0
		lineageTag: b05e5cfd-66b3-46e1-8c99-75abd6993add

	measure 'Avg churn probability' = AVERAGE(customer_scores[churn_probability])
		formatString: 0.0%
		lineageTag: d56156f4-c2c1-4f4c-8a2e-9e5e5f654e13

	column customer_id
		dataType: int64
		formatString: 0
		lineageTag: b994afdf-033b-4f35-9a94-4135fedbad01
		summarizeBy: none
		sourceColumn: customer_id

	column recency_days
		dataType: int64
		formatString: #,0
		lineageTag: 8a848132-cef9-49c6-ab5b-c2193fd3a4c9
		summarizeBy: none
		sourceColumn: recency_days

	column frequency
