		sourceColumn: actual
		sortByColumn: actual_order

	column predicted
		dataType: string
		lineageTag: a1461d4e-0205-42b4-9816-859226219bc8
		summarizeBy: none
		sourceColumn: predicted
		sortByColumn: predicted_order

	column customers
		dataType: int64
		formatString: #,0
		lineageTag: 7e04fe25-16da-491b-b866-e421ced7d33c
		summarizeBy: sum
		sourceColumn: customers

	column actual_order
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7df8d11e-60ae-4d88-97d9-ab9820d1f8ce
		summarizeBy: none
		sourceColumn: actual_order

	column predicted_order
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 89c9b6fd-bff9-44d4-8c0d-d2d816828a31
		summarizeBy: none
		sourceColumn: predicted_order

	partition confusion_matrix = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database("localhost:5433", "retail"),
					Data = Source{[Schema = "public", Item = "confusion_matrix"]}[Data]
				in
					Data

