model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["customer_segments","customer_scores"]

annotation PBI_ProTooling = ["DevMode"]

ref table customer_segments
ref table customer_scores

ref cultureInfo en-US

